{
  "manifest_version": 3,
  "name": "标签收纳箱",
  "version": "1.0.0",
  "minimum_chrome_version": "156",
  "description": "一键关闭当前窗口的其他标签页，收进侧边栏；需要时点一下原样打开，省内存又不丢页面。",
  "permissions": ["tabs", "storage", "sidePanel", "favicon"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "标签收纳箱",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "park-other-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "收纳当前窗口的其他标签页"
    }
  }
}
